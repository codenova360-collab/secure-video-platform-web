# Customer website — example environment.
# Copy to `.env.local` for local development. PLACEHOLDER VALUES ONLY — never commit real values.
# Never put secrets in NEXT_PUBLIC_* variables: those are bundled into browser code.

# ── Public (safe to expose to the browser) ───────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_IMAGE_BASE_URL=https://images.example.com          # Phase 3 (Cloudflare R2 public domain)
# NEXT_PUBLIC_MUX_DATA_ENV_KEY=                                  # Phase 8, optional (Mux Data, non-secret)

# ── Server only (used by the /api BFF proxy and server components) ──────────
# The API's base URL as reached from this server (no trailing /v1).
API_INTERNAL_URL=http://localhost:4000
# Must equal WEB_PROXY_SECRET in the API's environment (≥ 32 characters).
API_PROXY_SECRET=must-match-WEB_PROXY_SECRET-in-the-api-environment

# ── Monitoring (optional) ────────────────────────────────────────────────────
# SENTRY_DSN=
